{
  "name": "physlib-knowledge-graph",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/extract.mjs",
    "build:mathlib": "node scripts/extract-mathlib.mjs",
    "validate:data": "node scripts/validate.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "compare:imports": "node scripts/compare-imports.mjs",
